  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node ./esbuild.js && npm run build:webview && npm run mitre-attack:parse",
    "package": "set NODE_ENV=development && node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "tswatch": "tsc -b -w",
    "postinstall": "cd ./client && npm install && cd .. && cd ./server && npm install && cd ../client/webview && npm install",
    "pretest": "tsc -b",
    "build:webview": "cd ./client/webview/ && npm run build",
    "watch:webview": "cd ./client/webview/ && npm run dev",
    "lint": "eslint {client,server}/**",
    "format": "prettier {client,server}/**/*.{js,ts,jsx,tsx,css,scss} --write",
    "mitre-attack:fetch": "node ./mitre_attack/fetchMitreAttackData.js",
    "mitre-attack:parse": "node ./mitre_attack/parseMitreAttackData.js"
  },
