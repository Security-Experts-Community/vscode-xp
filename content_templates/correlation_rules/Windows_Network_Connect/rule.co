event Network_Connect:
    key:
        event_src.host, object.process.id, object.process.name
    filter {
        filter::NotFromCorrelator()
        and (
                (
                    event_src.title == "windows" 
                    and msgid == "5156"
                )
                or (
                    event_src.title == "sysmon" 
                    and msgid == "3"
                )
        )
        
        and filter::CheckWL_Networking("Windows_Network_Connect", )
    }

rule Windows_Network_Connect: Network_Connect+ timer 10s

    init {
        $labels = "w_auto|CheckWL_Networking"
        $count.subevents = 0
    }

    on Network_Connect {
        if $count.subevents == 0 then
            $status = status

            $object.process.id = object.process.id
            $object.process.name = object.process.name
            $object.process.path = object.process.path
            $object.process.fullpath = object.process.fullpath

            $direction = direction

            $src.host = src.host
            $src.ip = src.ip
            $src.port = src.port
            $src.asset = src.asset

            $protocol = protocol
			
            $dst.host = dst.host
            $dst.ip = dst.ip
            $dst.port = dst.port
            $dst.asset = dst.asset

            $event_src.host = event_src.host
            $event_src.fqdn = event_src.fqdn
            $event_src.hostname = event_src.hostname
            $event_src.ip = event_src.ip
            $event_src.asset = event_src.asset
            $event_src.vendor = event_src.vendor
            $event_src.title = event_src.title
            $event_src.subsys = event_src.subsys
            $event_src.category = event_src.category
            $event_src.rule = event_src.rule

            $alert.key = # join([src.ip, dst.ip + ":" + string(dst.port)], "|")
            $alert.context = # subject.process.fullpath
        endif
		
        if msgid == "3" then
            $object.account.domain = object.account.domain
            $object.account.fullname = object.account.fullname
            $object.account.name = object.account.name
            $object.account.id = object.account.id
			
            $object.process.guid = object.process.guid
            $object.process.fullpath = object.process.fullpath
			
            $src.host = src.host
            $src.fqdn = src.fqdn
            $src.hostname = src.hostname
            $src.asset = src.asset

            $dst.host = dst.host
            $dst.fqdn = dst.fqdn
            $dst.hostname = dst.hostname
            $dst.asset = dst.asset

            $protocol.layer7 = protocol.layer7
        endif

        $count.subevents = $count.subevents + 1
    }

emit {
    $correlation_type = ""

    $subject = "rule"
    $action = "detect"
    $object = "connection"   

    # фильтр с direction == "egress", то есть event_src = src
    if $event_src.ip == null  and not in_subnet($src.ip, "127.0.0.0/8") and find_substr($src.host, "docker.internal") == null then
        $event_src.ip = $src.ip
    endif
    
    if $dst.ip != null and not in_subnet($dst.ip, "127.0.0.0/8") and not in_subnet($dst.ip, "172.16.0.0/12") and not in_subnet($dst.ip, "192.168.0.0/16") and not in_subnet($dst.ip, "10.0.0.0/8") and not in_subnet($dst.ip, "224.0.0.0/4") and not exec_query("Check_if_subnet_is_specific", [$dst.ip]) then
        # dst - внешний
        $external_dst.host = $dst.host
        $external_dst.fqdn = $dst.fqdn
        $external_dst.hostname = $dst.hostname
        $external_dst.ip = $dst.ip
		
        $importance = "high"
    else
        #dst - внутренний
        $importance = "medium"
    endif

    $category.generic = "Attack"
    $category.high = ""
    $category.low = ""

    $incident.aggregation.key = join([$correlation_name, $event_src.host, $object.process.name], "|")
    $incident.severity = $importance
    $incident.category = "Undefined"
    $incident.aggregation.timeout = 2h
}
